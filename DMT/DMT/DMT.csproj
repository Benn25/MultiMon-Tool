<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>DMT</RootNamespace>
    <AssemblyName>DMT</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>

    <Version>2.13.0.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <AssemblyTitle>Dual Monitor Tools</AssemblyTitle>
    <Product>Dual Monitor Tools</Product>
    <Description>Tools for users with dual/multi monitor setups.&#13;&#10;&#13;&#10;This program incorporates the features previously provided by SwapScreen, DualLauncher, DualSnap and DualWallpaperChanger.</Description>
    <Company>GNE</Company>
    <Copyright>Copyright © 2009-2026 Gerald Evans</Copyright>

    <ApplicationIcon>DMT.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- Applied by ApplicationConfiguration.Initialize() in Program.Main -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <ApplicationUseCompatibleTextRendering>false</ApplicationUseCompatibleTextRendering>
    <!-- Keep the .NET Framework default font so the existing hand-laid-out forms are unchanged.
         Remove this once the UI has been reworked to use Segoe UI. -->
    <ApplicationDefaultFont>Microsoft Sans Serif, 8.25pt</ApplicationDefaultFont>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DMT.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="10.0.0" />
  </ItemGroup>

</Project>
