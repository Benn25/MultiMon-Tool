<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>DMT</RootNamespace>
    <AssemblyName>DMT</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>

    <Version>3.0.1.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <AssemblyTitle>Dual Monitor Tools</AssemblyTitle>
    <Product>Dual Monitor Tools</Product>
    <Description>Tools for users with dual/multi monitor setups.&#13;&#10;&#13;&#10;This program incorporates the features previously provided by SwapScreen, DualLauncher, DualSnap and DualWallpaperChanger.</Description>
    <Company>GNE</Company>
    <Copyright>Copyright © 2009-2026 Gerald Evans</Copyright>

    <ApplicationIcon>DMT.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- Applied by ApplicationConfiguration.Initialize() in Program.Main -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <ApplicationUseCompatibleTextRendering>false</ApplicationUseCompatibleTextRendering>
    <!-- The default font and colour mode (light/dark) are set in Program.Main from Library\Ui\Theme -->

    <!-- WFO5001: SetColorMode (dark mode) is marked as experimental -->
    <NoWarn>$(NoWarn);WFO5001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DMT.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="10.0.0" />
  </ItemGroup>

</Project>
